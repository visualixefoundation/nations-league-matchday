# Get a free key at https://highlightly.net/login (100 req/day free tier)
HIGHLIGHTLY_API_KEY=your_key_here

# "direct" (highlightly.net account) or "rapidapi" (RapidAPI account)
HIGHLIGHTLY_SOURCE=direct

# UEFA Nations League league ID on Highlightly.
# Confirmed id is 5039 — confirm with:
#   curl "https://soccer.highlightly.net/leagues?leagueName=UEFA%20Nations%20League" \
#     -H "x-rapidapi-key: YOUR_KEY"
# The app falls back to 5039 if this is empty.
NATIONS_LEAGUE_ID=5039
